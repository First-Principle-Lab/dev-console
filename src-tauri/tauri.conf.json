{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dev-console",
  "version": "0.0.1",
  "identifier": "ai.codemate.devconsole",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "bun run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Utility",
    "shortDescription": "Local commands and secrets console",
    "longDescription": "Dev Console keeps saved shell commands and secrets in a local tray app with a library window and a Super+F finder.",
    "license": "MIT",
    "publisher": "parththirwani",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "wl-clipboard",
          "xclip"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "libappindicator-gtk3",
          "wl-clipboard",
          "xclip"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2OEU3MTZFMDEyQ0JEMTIKUldRU3ZTd0JibkdPTm5nMVhHQlBFYUl4WTZUMjVpMFdpVWx6djRHYWtKWUQzaFVLcFJkV21IQzQK",
      "endpoints": [
        "https://github.com/parththirwani/dev-console/releases/latest/download/latest.json"
      ]
    }
  }
}
